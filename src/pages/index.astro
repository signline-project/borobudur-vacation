---
// WAJIB DI SINI: Astro akan langsung memasak Tailwind v4 Anda dengan sempurna
import '../styles/global.css';

const brandName = "Borobudur Vacation";

// VARIABEL SEO UNTUK HOMEPAGE
const metaTitle = "Borobudur Vacation | Private Tours & Car Rental Yogyakarta";
const metaDescription = "Explore Borobudur & Prambanan with English-speaking drivers. Private tours, sunrise trips, and car rental with driver in Yogyakarta. Book now!";

const tours = [
  {
    title: "Borobudur Sunrise Tour",
    tagline: "See the magical sunrise over the world’s largest Buddhist temple.",
    description: "Start your day early and witness the golden morning light shining over Borobudur and the surrounding hills. After exploring the temple’s reliefs, we can continue to visit Pawon and Mendut temples nearby.",
    price: "Inquire Price",
    image: "/images/borobudur-sunrise.jpg",
    included: "Private car + English-speaking driver, entrance ticket, hotel pick-up & drop-off",
    duration: "4–5 hours (starting around 4:00 AM)",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'm%20interested%20in%20the%20*Borobudur%20Sunrise%20Tour*."
  },
  {
    title: "Borobudur & Prambanan Full-Day Tour",
    tagline: "Two UNESCO World Heritage Sites in one day.",
    description: "Begin your journey at Borobudur Temple in the morning, then continue to Prambanan Temple in the afternoon. This is the perfect tour for culture and history lovers. Optional stop at Sultan’s Palace (Kraton) or Batik workshop on the way.",
    price: "Inquire Price",
    image: "/images/prambanan.jpg",
    included: "Private car + driver, entrance tickets, hotel pick-up & drop-off",
    duration: "8–10 hours",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'm%20interested%20in%20the%20*Borobudur%20and%20Prambanan%20Full-Day%20Tour*."
  },
  {
    title: "Merapi Jeep Adventure & Borobudur",
    tagline: "A mix of culture and adventure.",
    description: "Combine your Borobudur tour with a thrilling 4x4 jeep ride around Mount Merapi. Explore volcanic landscapes, bunker ruins, and see how the local communities live in the shadow of an active volcano.",
    price: "Inquire Price",
    image: "/images/merapi.jpg",
    included: "Private car + driver, jeep rental, entrance tickets",
    duration: "Full day",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'm%20interested%20in%20the%20*Merapi%20Jeep%20Adventure%20and%20Borobudur*."
  },
  {
    title: "Jomblang Cave & Prambanan Tour",
    tagline: "Adventure underground and cultural discovery.",
    description: "Descend into Jomblang Cave and witness the famous “heavenly light.” After lunch, head to Prambanan Temple for an afternoon exploration. This tour is ideal for adventure seekers who also love history.",
    price: "Inquire Price",
    image: "/images/jomblang.jpg",
    included: "Private car + driver, caving equipment, guide, lunch, Prambanan ticket",
    duration: "Full day (start at 7:00 AM)",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'm%20interested%20in%20the%20*Jomblang%20Cave%20and%20Prambanan%20Tour*."
  },
  {
    title: "Yogyakarta City Tour",
    tagline: "Discover the cultural heart of Yogyakarta.",
    description: "Visit the Sultan’s Palace (Kraton), Taman Sari Water Castle, batik workshops, and Malioboro Street. A relaxing day exploring Jogja’s traditions, history, and local life.",
    price: "Inquire Price",
    image: "/images/jogja.jpg",
    included: "Private car + driver, entrance tickets, hotel pick-up & drop-off",
    duration: "Half-day or Full day (flexible)",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'm%20interested%20in%20the%20*Yogyakarta%20City%20Tour*."
  },
  {
    title: "Bromo & Ijen Overland Tour",
    tagline: "From Yogyakarta to East Java’s famous volcanoes.",
    description: "For those with more time, we offer multi-day trips to Mount Bromo and Ijen Crater. Experience the breathtaking sunrise over Bromo and the magical blue flames at Ijen before continuing to Bali or returning to Yogya.",
    price: "Inquire Price",
    image: "/images/bromo.jpg",
    included: "Transport, accommodation, entrance fees, local guide",
    duration: "3–5 days (custom itinerary available)",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'm%20interested%20in%20the%20*Bromo%20and%20Ijen%20Overland%20Tour*."
  }
];

const rentals = [
  {
    unit: "Toyota Avanza",
    specs: "5-6 Seats • AC • Manual/Automatic",
    price: "Rp 550.000",
    period: "/ 12 Hours",
    image: "/images/avanza.jpg"
  },
  {
    unit: "Toyota Innova Reborn",
    specs: "6-7 Seats • Double AC • Spacious Luxury",
    price: "Rp 850.000",
    period: "/ 12 Hours",
    image: "/images/innova.jpg"
  },
  {
    unit: "Toyota Hiace Commuter",
    specs: "14 Seats • Roof AC • Perfect for Groups",
    price: "Rp 1.200.000",
    period: "/ 12 Hours",
    image: "/images/hiace.jpg"
  },
  {
    unit: "Toyota Alphard",
    specs: "5-6 VVIP Seats • Captain Seats • Premium Luxury",
    price: "Rp 3.000.000",
    period: "/ 12 Hours",
    image: "/images/alphard.jpg"
  }
];

const advantages = [
  { title: "English-Speaking Drivers", desc: "Friendly, reliable, and knowledgeable throughout your journey." },
  { title: "Private & Flexible Tours", desc: "No rushing around. Travel comfortably at your own desired pace." },
  { title: "Transparent Prices", desc: "All-inclusive rates with absolutely zero hidden costs." },
  { title: "Clean & Comfortable Cars", desc: "Well-maintained Toyota Avanza, Innova, Hiace, and premium SUVs." },
  { title: "Trusted by International Travelers", desc: "Backed by excellent reviews and a high rate of repeat customers." }
];

const steps = [
  { step: "01", title: "Inquire via WA or Email", desc: "Contact us easily through WhatsApp or Email to start the conversation." },
  { step: "02", title: "Share Your Plan", desc: "Tell us your preferred travel dates, destinations, or customized requests." },
  { step: "03", title: "Get Quotation & Confirm", desc: "Receive a quick, transparent price estimation and lock your trip schedule." },
  { step: "04", title: "Relax & Enjoy!", desc: "Sit back, relax, and let us handle your unforgettable Yogyakarta vacation!" }
];

const faqs = [
  {
    question: "How do I book a tour/rental with you?",
    answer: "You can easily book by clicking our 'Contact Us' button, which connects directly to our WhatsApp. Our team will assist with your reservation and itinerary customizable instantly."
  },
  {
    question: "Can I combine Borobudur & Prambanan?",
    answer: "Absolutely! We offer flexible full-day tours that combine both iconic UNESCO sites with comfortable private cars and expert local drivers."
  },
  {
    question: "What time does the Sunrise Tour start?",
    answer: "The Borobudur Sunrise Tour typically starts with a hotel pick-up around 3:30 - 4:00 AM to catch the magical morning light from the best spots."
  },
  {
    question: "Are your drivers English-speaking?",
    answer: "Yes, all our professional drivers are English-speaking local experts dedicated to making your journey comfortable and informative."
  },
  {
    question: "What type of vehicles do you provide?",
    answer: "We offer a modern fleet, including Toyota Avanza, Innova Reborn, Hiace, and premium Toyota Alphard, all well-maintained for your safety."
  },
  {
    question: "Is Yogyakarta safe for tourists?",
    answer: "Yes, Yogyakarta is widely known as a friendly and safe city for international tourists. We still advise standard safety precautions, but overall, it's very welcoming."
  }
];

---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style is:global>
      @import "../styles/global.css";
      
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
  </head>  

  <body class="bg-slate-50 text-slate-800 antialiased">

    <nav class="bg-white/80 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-slate-100">
      <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
        <span class="text-xl font-extrabold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent tracking-tight">
          {brandName}
        </span>
        {/* MENU NAVIGASI BAHASA INGGRIS */}
        <div class="hidden md:flex space-x-8 font-semibold text-slate-600 text-sm">
          <a href="#paket" class="hover:text-blue-600 transition-colors">Tour Packages</a>
          <a href="#rental" class="hover:text-blue-400 transition-colors">Car Rentals</a>
          <a href="#why-choose-us" class="hover:text-blue-400 transition-colors">Why Choose Us</a>
          <a href="#faq" class="hover:text-blue-400 transition-colors">FAQs</a>
        </div>
        <a href="#contact-cta" class="bg-slate-900 hover:bg-slate-800 text-white font-bold px-5 py-2.5 rounded-full text-xs transition-all shadow-sm">
          Contact Us
        </a>
      </div>
    </nav>

    <header class="relative bg-slate-900 text-white py-32 px-6 overflow-hidden min-h-[500px] flex items-center">
      <div 
  class="absolute inset-0 z-0 opacity-40 bg-cover bg-center" 
  style={`background-image: url('${import.meta.env.BASE_URL}/images/hero-travel.jpg');`}
></div>
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-900/80 to-transparent z-10"></div>
      
      <div class="max-w-4xl mx-auto relative z-20 text-center md:text-left w-full">
        <span class="inline-block bg-blue-500/20 text-blue-400 font-bold px-4 py-1.5 rounded-full text-xs tracking-wider uppercase mb-4 border border-blue-500/30">
          Your Trusted Travel Partner
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mb-6 leading-tight max-w-3xl">
          Discover Borobudur, Prambanan & Central Java with Local Experts
        </h1>
        <p class="text-base md:text-xl text-slate-300 mb-10 max-w-2xl leading-relaxed">
          Comfortable cars, English-speaking drivers, and customized itineraries for your perfect holiday.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
          <a href="#paket" class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-8 py-3.5 rounded-xl shadow-lg shadow-blue-600/30 transition-all text-center text-sm">
            View Tour Packages
          </a>
          <a href="#rental" class="bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-3.5 rounded-xl backdrop-blur-md transition-all text-center border border-white/20 text-sm">
            Private Car Rentals
          </a>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-6 py-20 space-y-32">

      <section id="paket" class="scroll-mt-24">
        <div class="max-w-2xl mx-auto text-center mb-16">
          <span class="text-blue-600 text-xs font-bold uppercase tracking-wider block mb-2">Our Offerings</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">Popular Tour Packages</h2>
          <div class="h-1 w-16 bg-blue-600 mx-auto rounded-full mb-4"></div>
          <p class="text-slate-500 text-sm md:text-base">
            Handpicked premium experiences crafted for an unforgettable vacation in Yogyakarta and beyond.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 items-start">
          {tours.map((tour) => (
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl border border-slate-100 overflow-hidden flex flex-col justify-between transition-all duration-300 [&:has(details[open])]:shadow-xl [&:has(details[open])]:border-blue-100">
              
              <div>
                {/* AREA IMAGE */}
                <div class="relative overflow-hidden h-52 bg-slate-200 shrink-0">
                  <img 
  src={`${import.meta.env.BASE_URL}${tour.image}`} 
  alt={tour.title} 
  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
/>
                </div>

                {/* AREA KONTEN UTAMA */}
                <div class="p-6">
                  <h3 class="text-lg font-bold text-slate-900 mb-1">
                    {tour.title}
                  </h3>
                  <p class="text-blue-600 text-xs font-semibold tracking-wide mb-4">
                    {tour.tagline}
                  </p>

                  {/* AKORDEON DETAILS YANG SUDAH DIPERBAIKI UI/UX-NYA */}
                  <details class="group/details border-t border-slate-100/80 pt-4">
                    {/* Summary bersih, menyamar menjadi teks interaktif yang elegan */}
                    <summary class="list-none flex items-center justify-between cursor-pointer text-xs font-bold text-slate-600 hover:text-blue-600 select-none transition-colors outline-none [&::-webkit-details-marker]:hidden">
                      <span class="tracking-wide uppercase text-[11px] text-slate-400 group-hover/details:text-blue-600 transition-colors">
                        View Itinerary & Details
                      </span>
                      {/* Ikon panah kustom yang akan berputar halus */}
                      <svg class="w-4 h-4 text-slate-400 transition-transform duration-300 group-open/details:rotate-180 group-open/details:text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </summary>
                    
                    {/* PANEL INFORMASI (BERSIH, TANPA KOTAK ABU-ABU KAKU) */}
                    <div class="mt-4 space-y-5 text-slate-600 text-xs md:text-sm border-l-2 border-blue-500 pl-4 py-0.5 animate-[fadeIn_0.3s_ease-out]">
                      <p class="text-slate-600 leading-relaxed font-normal text-justify">
                        {tour.description}
                      </p>
                      
                      <div class="space-y-3 pt-3 border-t border-slate-100">
                        <div class="flex flex-col gap-1">
                          <span class="text-[10px] uppercase font-extrabold tracking-wider text-blue-600">✓ Included</span>
                          <span class="text-slate-700 text-xs leading-relaxed font-medium">{tour.included}</span>
                        </div>
                        <div class="flex flex-col gap-1">
                          <span class="text-[10px] uppercase font-extrabold tracking-wider text-blue-600">⏱ Duration</span>
                          <span class="text-slate-700 text-xs font-medium">{tour.duration}</span>
                        </div>
                      </div>
                    </div>
                  </details>
                </div>
              </div>

              {/* AREA HARGA & ACTION BUTTON */}
              <div class="px-6 pb-6 pt-4 bg-slate-50/50 border-t border-slate-100 flex items-center justify-between shrink-0">
                <div>
                  <span class="text-[9px] text-slate-400 block uppercase font-extrabold tracking-wider">Starting From</span>
                  <span class="text-base font-black text-blue-600 tracking-tight">{tour.price}</span>
                </div>
                <a href="#contact-cta" class="bg-blue-600 hover:bg-indigo-600 text-white font-bold px-5 py-2.5 rounded-xl text-xs transition-all shadow-md shadow-blue-600/10 hover:shadow-indigo-600/20">
                  Book Now
                </a>
              </div>

            </div>
          ))}
        </div>
      </section>

      {/* 2. LAYANAN RENTAL MOBIL ANDA SEBELUMNYA TETAP DI SINI */}
	  <section id="rental" class="scroll-mt-24">
  <div class="max-w-2xl mx-auto text-center mb-16">
    <span class="text-blue-600 text-xs font-bold uppercase tracking-wider block mb-2">Transport Services</span>
    <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">
      Private Car Rentals
    </h2>
    <div class="h-1 w-16 bg-blue-600 mx-auto rounded-full mb-4"></div>
    <p class="text-slate-500 text-sm md:text-base">
      Modern, immaculate, and fully air-conditioned vehicles accompanied by professional drivers for a seamless journey.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 items-start">
          {rentals.map((rental) => (
            <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl border border-slate-100 overflow-hidden flex flex-col transition-all duration-300 group hover:-translate-y-1 h-full">
              
              {/* AREA FOTO MOBIL */}
              <div class="relative overflow-hidden h-40 bg-slate-100">
                <img 
                  src={`${import.meta.env.BASE_URL}${rental.image}`} 
                  alt={rental.unit} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                />
              </div>
              
              {/* DETAIL MOBIL (Hapus flex-grow agar space atas mengunci padat) */}
              <div class="p-5 pb-0">
                <h3 class="text-base font-bold text-slate-900 mb-1 group-hover:text-blue-600 transition-colors line-clamp-1">
                  {rental.unit}
                </h3>
                <span class="text-[10px] font-semibold text-blue-600 bg-blue-50 py-0.5 px-2 rounded-md inline-block mb-1">
                  {rental.specs}
                </span>
              </div>
              
              {/* BAGIAN BAWAH: HARGA & TOMBOL AKSI (Ditambah mt-auto untuk menarik space dari atas) */}
              <div class="px-5 pb-5 mt-auto">
                <div class="border-t border-dashed border-slate-200 pt-2 mb-4">
                  <span class="text-[9px] text-slate-400 block uppercase font-extrabold tracking-wider">Rental Rates</span>
                  <div class="flex items-baseline gap-0.5">
                    <span class="text-lg font-black text-slate-900 tracking-tight">{rental.price}</span>
                    <span class="text-[11px] text-slate-500 font-medium">{rental.period}</span>
                  </div>
                </div>

                <a href="#contact-cta" class="bg-slate-900 hover:bg-blue-600 text-white font-bold py-2.5 rounded-xl text-center text-xs transition-all block w-full uppercase tracking-wider">
                  Book Car
                </a>
              </div>

            </div>
          ))}
  </div>
</section>
      
      {/* 3. WHY CHOOSE US (MENGGUNAKAN DATA BOROBUDUR VACATION) */}
	  <section id="why-choose-us" class="bg-slate-900 text-white rounded-3xl p-8 md:p-16 relative overflow-hidden shadow-xl">
        <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="grid lg:grid-cols-12 gap-12 items-center relative z-10">
          <div class="lg:col-span-5 space-y-4 text-center lg:text-left">
            <span class="text-blue-400 text-xs font-bold uppercase tracking-wider block">Why Borobudur Vacation?</span>
            <h2 class="text-3xl md:text-4xl font-black tracking-tight leading-tight">
              We Craft Perfect Holiday Experiences
            </h2>
            <p class="text-slate-400 text-sm leading-relaxed">
              Your comfort and safety are our top priorities. Here is why hundreds of international travelers choose us as their trusted local partner in Yogyakarta.
            </p>
          </div>
          
          <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6">
            {advantages.map((adv) => (
              <div class="bg-white/5 backdrop-blur-sm p-6 rounded-xl border border-white/10 hover:border-white/20 transition-all">
                <div class="flex items-start gap-3">
                  <div class="text-emerald-400 mt-0.5 text-lg shrink-0">✅</div>
                  <div>
                    <h4 class="font-bold text-white text-sm md:text-base mb-1">{adv.title}</h4>
                    <p class="text-slate-400 text-xs leading-relaxed">{adv.desc}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* 4. HOW IT WORKS */}
	  <section id="how-it-works" class="scroll-mt-24">
        <div class="max-w-2xl mx-auto text-center mb-16">
          <span class="text-blue-600 text-xs font-bold uppercase tracking-wider block mb-2">Plan Your Trip</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-4">How It Works</h2>
          <div class="h-1 w-16 bg-blue-600 mx-auto rounded-full"></div>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 relative">
          <div class="hidden lg:block absolute top-16 left-20 right-20 h-0.5 bg-slate-200/60 z-0"></div>
          
          {steps.map((item) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm relative z-10 flex flex-col items-center text-center group hover:border-blue-200 transition-all duration-300">
              <div class="relative mb-6">
                <span class="absolute -top-6 -left-10 text-6xl font-black text-slate-100/80 select-none tracking-tighter group-hover:text-blue-50 transition-colors duration-300 z-0">{item.step}</span>
                <div class="w-12 h-12 bg-blue-600 text-white font-extrabold flex items-center justify-center rounded-full text-sm shadow-md shadow-blue-600/20 relative z-10 group-hover:scale-110 transition-transform">
                  {parseInt(item.step)}
                </div>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-2 mt-2 group-hover:text-blue-600 transition-colors">{item.title}</h3>
              <p class="text-slate-500 text-xs leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <section id="faqs" class="py-20 bg-neutral-50">
  <div class="container mx-auto px-6 max-w-4xl">
    
    <div class="text-center mb-12">
      <p class="text-blue-600 font-bold tracking-wider text-sm uppercase mb-2">Have Questions?</p>
      <h2 class="text-4xl md:text-5xl font-extrabold text-neutral-900 mb-4">Frequently Asked Questions</h2>
      <p class="text-lg text-neutral-600 max-w-2xl mx-auto">Can't find the answer? Contact our local experts instantly via WhatsApp for personalized assistance.</p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <div class="faq-item bg-white rounded-2xl border border-neutral-200/80 shadow-sm overflow-hidden transition-all duration-300">
          
          <button 
            class="faq-toggle w-full text-left px-6 py-5 md:px-8 md:py-6 flex items-center justify-between gap-4 hover:bg-neutral-50/50 transition-colors focus:outline-none"
            aria-expanded="false"
          >
            <span class="text-lg font-bold text-neutral-900 md:text-xl transition-colors group-hover:text-blue-600">
  {faq.question}
</span>
            <span class="faq-icon text-2xl text-blue-600 font-medium transition-transform duration-300 select-none shrink-0">+</span>
          </button>
          
          <div class="faq-content max-h-0 opacity-0 overflow-hidden transition-all duration-300 ease-in-out bg-neutral-50/30">
  {/* PERBAIKAN UTAMA: Kita samakan px-6 md:px-8 agar sejajar dengan tombol di atasnya, serta rapikan pt dan pb */}
  <div class="px-6 pb-6 md:px-8 md:pb-8 text-base md:text-lg text-neutral-600 border-t border-neutral-100 pt-5 leading-relaxed">
    <p>{faq.answer}</p>
  </div>
</div>
          
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  function initFAQ() {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach(item => {
      const toggleBtn = item.querySelector('.faq-toggle');
      const content = item.querySelector('.faq-content') as HTMLElement;
      const icon = item.querySelector('.faq-icon');

      if (!toggleBtn || !content || !icon) return;

      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        
        // 1. Tutup semua FAQ lain yang sedang terbuka (Efek Accordion Tunggal)
        faqItems.forEach(otherItem => {
          if (otherItem !== item) {
            const otherBtn = otherItem.querySelector('.faq-toggle');
            const otherContent = otherItem.querySelector('.faq-content') as HTMLElement;
            const otherIcon = otherItem.querySelector('.faq-icon');
            
            if (otherBtn && otherContent && otherIcon) {
              otherBtn.setAttribute('aria-expanded', 'false');
              otherContent.style.maxHeight = '0';
              otherContent.style.opacity = '0';
              otherIcon.textContent = '+';
              otherIcon.style.transform = 'rotate(0deg)';
              otherItem.classList.remove('border-blue-500', 'shadow-md');
            }
          }
        });

        // 2. Toggle status item yang di-klik
        if (isExpanded) {
          toggleBtn.setAttribute('aria-expanded', 'false');
          content.style.maxHeight = '0';
          content.style.opacity = '0';
          icon.textContent = '+';
          icon.style.transform = 'rotate(0deg)';
          item.classList.remove('border-blue-500', 'shadow-md');
        } else {
          toggleBtn.setAttribute('aria-expanded', 'true');
          // Isi maxHeight secara dinamis berdasarkan tinggi asli konten teksnya
          content.style.maxHeight = content.scrollHeight + 'px';
          content.style.opacity = '1';
          icon.textContent = '−'; // Berubah jadi minus murni
          item.classList.add('border-blue-500', 'shadow-md');
        }
      });
    });
  }

  // Jalankan fungsi saat halaman pertama kali dimuat
  document.addEventListener('DOMContentLoaded', initFAQ);
  // Antisipasi jika Astro menggunakan ViewTransitions
  document.addEventListener('astro:page-load', initFAQ);
</script>

