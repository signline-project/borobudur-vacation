---
import '../styles/global.css';

const brandName = "Borobudur Vacation";

// SEO Metadata
const metaTitle = "Borobudur Vacation | Private Tours & Car Rental in Yogyakarta";
const metaDescription = "Experience Borobudur and Prambanan with expert English-speaking drivers. Private cultural tours, sunrise trips, and dependable car rental in Yogyakarta.";

const tours = [
  {
    id: "borobudur-sunrise",
    title: "Borobudur Sunrise Tour",
    category: "Cultural Highlight",
    tagline: "Witness the peaceful dawn over the world's largest Buddhist sanctuary.",
    description: "Depart early from your hotel to catch the first golden morning light bathing the stupas of Borobudur and the Menoreh hills. Explore the ancient stone reliefs with peaceful morning serenity, followed by visits to nearby Pawon and Mendut temples.",
    price: "Inquire for Quote",
    image: "/images/borobudur-sunrise.jpg",
    included: "Private air-conditioned car, English-speaking driver, temple entry tickets, hotel pick-up and drop-off",
    duration: "4 to 5 hours (Early morning departure around 4:00 AM)",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'm%20interested%20in%20booking%20the%20*Borobudur%20Sunrise%20Tour*."
  },
  {
    id: "borobudur-prambanan",
    title: "Borobudur & Prambanan Full-Day Tour",
    category: "UNESCO Heritage",
    tagline: "Two world heritage masterpieces in one seamless private excursion.",
    description: "Begin your journey at Borobudur Temple in the fresh morning air, then journey across Yogyakarta to the towering Hindu spires of Prambanan. Includes an optional stop at the Sultan Palace (Kraton) or traditional batik craft studio along the route.",
    price: "Inquire for Quote",
    image: "/images/prambanan.jpg",
    included: "Private car with English-speaking driver, entrance admissions, fuel, parking fees, hotel transfers",
    duration: "8 to 10 hours (Flexible start from 7:30 AM)",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'm%20interested%20in%20booking%20the%20*Borobudur%20and%20Prambanan%20Full-Day%20Tour*."
  },
  {
    id: "merapi-jeep-borobudur",
    title: "Merapi 4x4 Jeep Adventure & Borobudur",
    category: "Heritage & Adventure",
    tagline: "A thrilling blend of ancient heritage and volcanic exploration.",
    description: "Pair your morning cultural immersion at Borobudur with an exhilarating open-top 4x4 jeep expedition around Mount Merapi. Traverse historic lava streams, visit the underground bunker ruins, and witness life on the slopes of Java's most active volcano.",
    price: "Inquire for Quote",
    image: "/images/merapi.jpg",
    included: "Private transport, 4x4 Merapi Jeep rental with local driver, entrance tickets, mineral water",
    duration: "Full day (Approx. 8 hours)",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'm%20interested%20in%20booking%20the%20*Merapi%20Jeep%20Adventure%20and%20Borobudur*."
  },
  {
    id: "jomblang-prambanan",
    title: "Jomblang Cave & Prambanan Temple",
    category: "Nature & Wonder",
    tagline: "Rappel into subterranean caverns and marvel at the light of heaven.",
    description: "Descend 60 meters underground into Jomblang Cave using certified vertical caving gear to witness the legendary sunbeam illumination. Enjoy a local boxed lunch before heading back to Yogyakarta for a leisurely afternoon at Prambanan Temple.",
    price: "Inquire for Quote",
    image: "/images/jomblang.jpg",
    included: "Private transport with driver, complete caving gear and cave guides, boxed lunch, Prambanan ticket",
    duration: "Full day (Starts at 6:30 AM to catch cave slot)",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'm%20interested%20in%20booking%20the%20*Jomblang%20Cave%20and%20Prambanan%20Tour*."
  },
  {
    id: "yogyakarta-city-tour",
    title: "Yogyakarta Royal Heritage City Tour",
    category: "Culture & Living Traditions",
    tagline: "Delve into the royal palaces, historic water castles, and artisan quarters.",
    description: "Uncover the living heart of Javanese culture. Visit the Sultan's Palace (Kraton), stroll through the fragrant courtyards of Taman Sari Water Castle, watch master batik craftsmen, and explore historical Kotagede silver workshops at your own pace.",
    price: "Inquire for Quote",
    image: "/images/jogja.jpg",
    included: "Private vehicle, experienced English-speaking driver, entry admissions, hotel pick-up and drop-off",
    duration: "6 to 8 hours (Customizable start time)",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'm%20interested%20in%20booking%20the%20*Yogyakarta%20City%20Tour*."
  },
  {
    id: "bromo-ijen-overland",
    title: "Bromo & Ijen Crater Volcano Overland",
    category: "Multi-Day Expedition",
    tagline: "Journey across East Java's dramatic volcanic landscapes to Bali.",
    description: "For adventurous explorers with multiple days, embark on an overland journey from Yogyakarta across East Java. Stand above the Sea of Sand for sunrise over Mount Bromo, and hike Mount Ijen by night to observe the rare electric-blue sulfur fires before continuing to Bali or returning to Yogyakarta.",
    price: "Inquire for Quote",
    image: "/images/bromo.jpg",
    included: "Private long-distance vehicle, dedicated driver, hotel accommodations, 4x4 Bromo jeep, local mountain guides",
    duration: "3 to 4 days (Tailored route options available)",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'm%20interested%20in%20the%20*Bromo%20and%20Ijen%20Overland%20Tour*."
  }
];

const rentals = [
  {
    unit: "Toyota Avanza",
    category: "Economical & Compact",
    capacity: "Up to 5 Guests",
    specs: "Air Conditioned • 2-3 Suitcases • Smooth & Reliable",
    price: "Rp 550.000",
    period: "per 12 Hours",
    included: "Vehicle, English-speaking driver, and fuel in Yogyakarta area",
    image: "/images/avanza.jpg",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'd%20like%20to%20rent%20the%20*Toyota%20Avanza*%20with%20driver."
  },
  {
    unit: "Toyota Innova Reborn",
    category: "Most Popular Comfort",
    capacity: "Up to 6 Guests",
    specs: "Dual Blower AC • 3-4 Suitcases • Spacious Suspension",
    price: "Rp 850.000",
    period: "per 12 Hours",
    included: "Vehicle, English-speaking driver, and fuel in Yogyakarta area",
    image: "/images/innova.jpg",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'd%20like%20to%20rent%20the%20*Toyota%20Innova%20Reborn*%20with%20driver."
  },
  {
    unit: "Toyota Hiace Commuter",
    category: "Group & Family Travel",
    capacity: "Up to 14 Guests",
    specs: "High Ceiling • Large Luggage Space • Dedicated Group Comfort",
    price: "Rp 1.200.000",
    period: "per 12 Hours",
    included: "Vehicle, professional driver, and fuel in Yogyakarta area",
    image: "/images/hiace.jpg",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'd%20like%20to%20rent%20the%20*Toyota%20Hiace%20Commuter*%20with%20driver."
  },
  {
    unit: "Toyota Alphard",
    category: "VIP Luxury",
    capacity: "Up to 5 Guests",
    specs: "Executive Captain Seats • Silent Cabin • Supreme Comfort",
    price: "Rp 3.000.000",
    period: "per 12 Hours",
    included: "VIP vehicle, professional chauffeur, and fuel in Yogyakarta area",
    image: "/images/alphard.jpg",
    waLink: "https://api.whatsapp.com/send?phone=628123456789&text=Hello,%20I'd%20like%20to%20rent%20the%20*Toyota%20Alphard*%20with%20driver."
  }
];

const values = [
  {
    title: "English-Speaking Local Drivers",
    description: "Our drivers are friendly, punctual, and communicate clearly in English. They know the quietest times for temple visits and the best local dining spots.",
    tag: "Communication"
  },
  {
    title: "Fully Tailored & Private Itineraries",
    description: "No shared tour buses or rigid schedules. You travel exclusively with your party and can adjust stops, photography breaks, and rest times as you like.",
    tag: "Flexibility"
  },
  {
    title: "Upfront & All-Inclusive Pricing",
    description: "Every quotation clearly states vehicle, driver, fuel, and admissions. There are no sudden parking fees or unexpected surcharges during your trip.",
    tag: "Transparency"
  },
  {
    title: "Immaculate & Regularly Serviced Fleet",
    description: "Every car is thoroughly cleaned, washed, and safety checked prior to each excursion, ensuring cool air-conditioning and total reliability.",
    tag: "Safety & Comfort"
  }
];

const steps = [
  {
    number: "01",
    title: "Tell Us Your Travel Ideas",
    text: "Contact us via WhatsApp or email with your preferred dates, party size, and places you would like to explore."
  },
  {
    number: "02",
    title: "Receive a Tailored Itinerary",
    text: "We provide an optimized route schedule with clear pickup times, vehicle recommendation, and transparent pricing."
  },
  {
    number: "03",
    title: "Confirm Your Booking",
    text: "Review and lock in your schedule with no tedious paperwork. We hold your vehicle and driver exclusively."
  },
  {
    number: "04",
    title: "Enjoy Your Private Journey",
    text: "Your driver greets you on time at your hotel lobby. Sit back, take in the landscapes, and explore Yogyakarta comfortably."
  }
];

const faqs = [
  {
    question: "How do I make a reservation with Borobudur Vacation?",
    answer: "You can book directly by clicking our WhatsApp buttons or sending us an email. Let us know your travel dates, hotel location, and chosen tour or vehicle. We will reply promptly with full confirmation and schedule details."
  },
  {
    question: "Can Borobudur and Prambanan be combined in a single day?",
    answer: "Yes, this is our most requested tour package. Because Borobudur sits northwest of Yogyakarta and Prambanan sits to the east, our drivers plan the route to visit Borobudur during the calmer morning hours and Prambanan in the afternoon light."
  },
  {
    question: "What time does the Sunrise Tour start?",
    answer: "For the sunrise experience, hotel pick-up in Yogyakarta city typically occurs between 3:45 AM and 4:00 AM, allowing us to arrive at the viewing grounds before the first morning glow spreads across the temple valley."
  },
  {
    question: "Are your drivers fluent in English?",
    answer: "Yes, all our primary drivers speak conversational and clear English. They assist with temple entry arrangements, recommend authentic local food, and provide helpful cultural context throughout your journey."
  },
  {
    question: "What items are included in the private car rental?",
    answer: "Our standard 12-hour car rental rate includes the vehicle, an English-speaking driver, fuel (petrol) within the Yogyakarta and Borobudur region, and hotel pick-up and drop-off."
  },
  {
    question: "Is Yogyakarta a welcoming destination for international travelers?",
    answer: "Yogyakarta is widely celebrated as one of Indonesia's most hospitable and safe cultural cities. Locals are warm and welcoming to visitors. Standard travel common sense applies, and our private drivers ensure peace of mind at every destination."
  }
];
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    
    <!-- Google Fonts: Playfair Display for editorial headers & Plus Jakarta Sans for UI readability -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,400;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>  

  <body class="bg-[#FAF8F5] text-stone-900 antialiased font-sans-ui selection:bg-[#A84820]/20 selection:text-stone-900">

    <!-- NAVIGATION BAR -->
    <header class="sticky top-0 z-50 bg-[#FAF8F5]/95 backdrop-blur-md border-b border-stone-200/80 transition-shadow duration-300">
      <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
        
        <!-- Brand Logo / Typographic Wordmark -->
        <a href="#" class="group inline-flex flex-col focus-visible:ring-2 focus-visible:ring-[#A84820] rounded-lg p-1">
          <span class="font-serif-display text-2xl font-bold text-stone-950 tracking-tight group-hover:text-[#A84820] transition-colors">
            {brandName}
          </span>
          <span class="text-[11px] uppercase tracking-widest text-stone-700 font-semibold">
            Central Java Private Tours
          </span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center space-x-8 text-sm font-semibold text-stone-700" aria-label="Main Navigation">
          <a href="#paket" class="hover:text-[#A84820] transition-colors py-1">Tour Packages</a>
          <a href="#rental" class="hover:text-[#A84820] transition-colors py-1">Car Rentals</a>
          <a href="#why-choose-us" class="hover:text-[#A84820] transition-colors py-1">Why Choose Us</a>
          <a href="#faq" class="hover:text-[#A84820] transition-colors py-1">FAQs</a>
        </nav>

        <!-- Desktop Action -->
        <div class="hidden md:flex items-center">
          <a 
            href="#contact-cta" 
            class="bg-stone-900 hover:bg-[#A84820] text-white font-semibold px-5 py-2.5 rounded-lg text-xs tracking-wide transition-all shadow-sm focus-visible:ring-2 focus-visible:ring-stone-900"
          >
            Plan Your Journey
          </a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <div class="md:hidden flex items-center">
          <button 
            id="mobile-menu-toggle"
            type="button" 
            class="p-2.5 rounded-lg text-stone-700 hover:text-stone-950 hover:bg-stone-100 transition-colors focus-visible:ring-2 focus-visible:ring-[#A84820]"
            aria-expanded="false" 
            aria-controls="mobile-menu"
            aria-label="Toggle navigation menu"
          >
            <!-- Hamburger Icon (Default) -->
            <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <!-- Close Icon (Hidden by default) -->
            <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

      </div>

      <!-- Mobile Navigation Drawer -->
      <div 
        id="mobile-menu" 
        class="hidden md:hidden border-t border-stone-200 bg-[#FAF8F5] px-6 py-6 transition-all duration-300 shadow-xl"
        role="navigation"
        aria-label="Mobile Navigation"
      >
        <div class="flex flex-col space-y-4">
          <a href="#paket" class="mobile-nav-link text-base font-semibold text-stone-800 hover:text-[#A84820] py-2 border-b border-stone-100">
            Tour Packages
          </a>
          <a href="#rental" class="mobile-nav-link text-base font-semibold text-stone-800 hover:text-[#A84820] py-2 border-b border-stone-100">
            Car Rentals
          </a>
          <a href="#why-choose-us" class="mobile-nav-link text-base font-semibold text-stone-800 hover:text-[#A84820] py-2 border-b border-stone-100">
            Why Choose Us
          </a>
          <a href="#faq" class="mobile-nav-link text-base font-semibold text-stone-800 hover:text-[#A84820] py-2 border-b border-stone-100">
            Frequently Asked Questions
          </a>
          <div class="pt-2">
            <a 
              href="https://api.whatsapp.com/send?phone=628123456789&text=Hello%20Borobudur%20Vacation,%20I'd%20like%20to%20plan%20a%20private%20trip."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full bg-[#A84820] hover:bg-[#8F3B18] text-white font-bold py-3 px-4 rounded-lg flex items-center justify-center gap-2 text-sm shadow-sm"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.155.57 4.178 1.564 5.924l-1.664 6.08 6.223-1.633c1.705.932 3.666 1.469 5.877 1.469 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
              </svg>
              <span>Chat via WhatsApp</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <main class="space-y-24 md:space-y-36 pb-20">

      <!-- HERO SECTION -->
      <section class="relative bg-stone-950 text-white min-h-[580px] flex items-center overflow-hidden">
        <!-- Background Image with Scrim -->
        <div 
          class="absolute inset-0 z-0 bg-cover bg-center opacity-45 transform scale-105 transition-transform duration-1000 ease-out" 
          style={`background-image: url('${import.meta.env.BASE_URL}/images/hero-travel.jpg');`}
          aria-hidden="true"
        ></div>
        <div class="absolute inset-0 bg-gradient-to-r from-stone-950 via-stone-950/85 to-stone-900/40 z-10" aria-hidden="true"></div>

        <div class="max-w-6xl mx-auto px-6 py-20 relative z-20 w-full">
          <div class="max-w-3xl space-y-6">
            
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-md bg-stone-900/90 border border-stone-700/80 text-stone-200 text-xs font-semibold tracking-wider uppercase">
              <span class="w-2 h-2 rounded-full bg-[#E07A5F]"></span>
              Private Tours & Driver Hire Yogyakarta
            </div>

            <h1 class="font-serif-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15] text-white">
              Discover Borobudur & Java with Personal Local Guidance
            </h1>

            <p class="text-stone-300 text-base sm:text-lg leading-relaxed max-w-2xl font-normal">
              Private itineraries, dedicated air-conditioned cars, and friendly English-speaking local drivers. Travel comfortably at your own rhythm without crowded tour buses.
            </p>

            <div class="pt-4 flex flex-col sm:flex-row gap-4">
              <a 
                href="#paket" 
                class="bg-[#A84820] hover:bg-[#8F3B18] text-white font-bold px-7 py-3.5 rounded-lg transition-colors text-center text-sm shadow-md focus-visible:ring-2 focus-visible:ring-white"
              >
                View Tour Packages
              </a>
              <a 
                href="#rental" 
                class="bg-stone-900/80 hover:bg-stone-800 text-white font-semibold px-7 py-3.5 rounded-lg border border-stone-700 transition-colors text-center text-sm focus-visible:ring-2 focus-visible:ring-white"
              >
                Private Car Rental
              </a>
            </div>

          </div>
        </div>
      </section>

      <!-- 1. TOUR PACKAGES SECTION -->
      <section id="paket" class="max-w-6xl mx-auto px-6 scroll-mt-28">
        
        <!-- Section Header -->
        <div class="max-w-2xl mb-14">
          <span class="text-[#A84820] text-xs font-extrabold uppercase tracking-widest block mb-2">
            Curated Itineraries
          </span>
          <h2 class="font-serif-display text-3xl sm:text-4xl font-bold text-stone-950 tracking-tight mb-3">
            Handcrafted Private Tour Packages
          </h2>
          <p class="text-stone-600 text-sm sm:text-base leading-relaxed">
            Private day trips and multi-day explorations with guaranteed transparent inclusions and flexible departure hours.
          </p>
        </div>

        <!-- Tour Cards Grid -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {tours.map((tour) => (
            <article class="bg-white rounded-xl border border-stone-200/90 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between overflow-hidden">
              
              <div>
                <!-- Tour Image -->
                <div class="relative h-56 bg-stone-200 overflow-hidden">
                  <img 
                    src={`${import.meta.env.BASE_URL}${tour.image}`} 
                    alt={tour.title} 
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" 
                  />
                  <span class="absolute top-3.5 left-3.5 bg-stone-950/85 text-stone-100 text-[11px] font-bold px-3 py-1 rounded tracking-wide backdrop-blur-sm">
                    {tour.category}
                  </span>
                </div>

                <!-- Tour Content -->
                <div class="p-6">
                  <h3 class="font-serif-display text-xl font-bold text-stone-950 mb-2 leading-snug">
                    {tour.title}
                  </h3>
                  <p class="text-stone-600 text-xs sm:text-sm mb-4 leading-relaxed">
                    {tour.tagline}
                  </p>

                  <!-- Accessible Accordion Details -->
                  <details class="group/tour-details border-t border-stone-100 pt-3">
                    <summary class="list-none flex items-center justify-between cursor-pointer py-1 text-xs font-bold text-[#A84820] hover:text-[#8F3B18] transition-colors focus-visible:ring-1 focus-visible:ring-[#A84820] rounded">
                      <span class="uppercase tracking-wider text-[11px]">View Full Itinerary & Inclusions</span>
                      <svg class="w-4 h-4 text-stone-500 transition-transform duration-200 group-open/tour-details:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                      </svg>
                    </summary>

                    <div class="mt-3 space-y-3.5 text-xs text-stone-700 bg-stone-50 p-3.5 rounded-lg border border-stone-200/70 animate-fadeIn">
                      <p class="leading-relaxed">
                        {tour.description}
                      </p>
                      
                      <div class="space-y-2 pt-2 border-t border-stone-200/80">
                        <div>
                          <span class="font-bold text-stone-900 block text-[11px] uppercase tracking-wide">Included:</span>
                          <span class="text-stone-600 leading-relaxed block">{tour.included}</span>
                        </div>
                        <div>
                          <span class="font-bold text-stone-900 block text-[11px] uppercase tracking-wide">Duration:</span>
                          <span class="text-stone-600 block">{tour.duration}</span>
                        </div>
                      </div>
                    </div>
                  </details>
                </div>
              </div>

              <!-- Price & Direct Action -->
              <div class="px-6 py-4 bg-stone-50/80 border-t border-stone-100 flex items-center justify-between gap-3">
                <div>
                  <span class="text-[10px] uppercase font-bold text-stone-500 tracking-wider block">Price Estimation</span>
                  <span class="text-sm font-bold text-stone-900">{tour.price}</span>
                </div>
                
                <!-- Direct WhatsApp Booking with prefilled tour title -->
                <a 
                  href={tour.waLink} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="bg-[#2D4A3E] hover:bg-stone-900 text-white font-semibold text-xs px-4 py-2 rounded-lg transition-colors flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-[#2D4A3E]"
                  aria-label={`Inquire about ${tour.title} on WhatsApp`}
                >
